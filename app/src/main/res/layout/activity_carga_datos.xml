<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/gris"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CargaDatos">

    <LinearLayout
        android:id="@+id/lyEncabezado"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="@color/md_theme_light_primary"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/imgbtnatras"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:backgroundTint="@color/md_theme_light_primary"
            android:contentDescription="btnRegresar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/outline_arrow_back_24"/>

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CARGAR DATOS"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="125dp"
        android:layout_margin="@dimen/marginDefault"
        app:cardCornerRadius="@dimen/CornerRadiusDefault"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lyEncabezado">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="125dp"
            android:padding="@dimen/margin8dp">

            <ImageView
                android:id="@+id/imgClientes"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/clientes"
                android:contentDescription="imgClientes"
                android:layout_marginStart="@dimen/marginDouble"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <Button
                android:id="@+id/btnCargarClientes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin8dp"
                android:text="Clientes"
                android:contentDescription="btnClientes"
                android:textAlignment="center"
                android:textColor="@color/gris"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/imgClientes"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cvBorrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="125dp"
        android:layout_margin="@dimen/marginDefault"
        app:cardCornerRadius="@dimen/CornerRadiusDefault"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvClientes">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="125dp"
            android:padding="@dimen/margin8dp">

            <ImageView
                android:id="@+id/imgBorrar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/borrar"
                android:contentDescription="imgClientes"
                android:layout_marginStart="@dimen/marginDouble"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <Button
                android:id="@+id/btnBorrarAviso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Borrar Avisos Antiguos"
                android:textSize="15sp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/gris"
                android:layout_marginStart="@dimen/margin8dp"
                app:layout_constraintStart_toEndOf="@id/imgBorrar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>